# Development defaults; Railway must set production values in its variables UI.
NODE_ENV=development
PORT=3000
DB_ENGINE=sqlite
RAWASI_DB_PATH=server/database/rawasi_aden.db
# In production/staging: mount a volume at /data; provide an existing verified database.
# RAWASI_DATA_DIR=/data
# RAWASI_DB_PATH=/data/rawasi_aden.db
# RAWASI_UPLOAD_DIR=/data/uploads
# RAWASI_PROJECTS_DIR=/data/projects
# RAWASI_BACKUP_DIR=/data/backups
# RAWASI_SCRATCH_DIR=/data/scratch
# Required in production/staging: independent randomly generated secrets, at least 32 characters.
JWT_SECRET=
CLIENT_JWT_SECRET=
# Preserve the existing bank encryption key until an approved re-encryption migration is completed.
BANK_ENCRYPTION_KEY=
CORS_ORIGINS=
ENABLE_SCHEDULERS=false
WEB_CONCURRENCY=1
# Only used when DB_ENGINE=mysql is explicitly selected; never falls back to SQLite.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=rawasi
MYSQL_PASSWORD=
MYSQL_DATABASE=rawasi_aden
MYSQL_CONNECTION_LIMIT=10
