# انسخ إلى .env وعدّل القيم — لا تُدخل .env في Git أبداً
# متغيرات نظام رواسي عدن (كلها اختيارية في التطوير، بعضها إلزامي في الإنتاج)

# إلزامي في الإنتاج (NODE_ENV=production) — يرفض الإقلاع بدونه
JWT_SECRET=ضع-هنا-سلسلة-عشوائية-طويلة-واحفظها-في-مكان-آمن

# development | staging | production
NODE_ENV=development

# المنفذ (5500 افتراضي، 5501 للـ staging)
PORT=5500

# محرك قاعدة البيانات: auto (MySQL ثم سقوط محلي) | sqlite (محلي مباشرة) | mysql (صارم: يفشل بصوت عالٍ)
DB_ENGINE=auto

# مسار قاعدة SQLite (افتراضي: server/database/rawasi_aden.db)
# RAWASI_DB_PATH=

# أصول CORS المسموح بها في الإنتاج (مفصولة بفواصل) — مثال الواجهة على استضافة خارجية:
# CORS_ORIGINS=https://app.example.com

# الحد الأقصى لحجم الطلبات JSON (افتراضي 5mb؛ مسارا الأرشفة/التقارير يحملان 40mb الخاص بهما)
# JSON_BODY_LIMIT=5mb

# MySQL (يُستخدم فقط عند DB_ENGINE=mysql أو auto مع خادم متاح)
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=
# MYSQL_DATABASE=rawasi_aden

# قاعدة البيانات السحابية (اختياري — يستخدمها connectionManager.js عند توفره)
# ONLINE_DB_URL=
# ONLINE_DB_KEY=
