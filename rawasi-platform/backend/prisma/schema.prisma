generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleCode {
  SUPER_ADMIN
  SUPERVISOR_VENDOR
  CLIENT
  FIELD_PROMOTER
}

enum OrderStatus {
  SUBMITTED
  SUPERVISOR_REVIEW
  PENDING_ADMIN_APPROVAL
  REJECTION_REQUESTED
  QUOTED_TO_CLIENT
  CLIENT_APPROVED
  CLIENT_REJECTED
  IN_PROGRESS
  COMPLETED
  REJECTED_BY_ADMIN
  CANCELLED
}

enum ContractType {
  FULL_SERVICE
  LABOR_ONLY
}

enum VendorStatus {
  ACTIVE
  SUSPENDED
  EXPIRED
}

enum CostItemType {
  BASE
  EXTRA
}

enum CustodyType {
  ISSUE
  RETURN
  ADJUSTMENT
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  code        RoleCode         @unique
  name        String
  users       User[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  deletedAt   DateTime?        @map("deleted_at")

  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique @db.VarChar(100)
  description String?
  roles       RolePermission[]
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  deletedAt   DateTime?        @map("deleted_at")

  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)
  createdAt    DateTime   @default(now()) @map("created_at")
  createdById  String?    @map("created_by_id") @db.Uuid

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model User {
  id              String               @id @default(uuid()) @db.Uuid
  fullName        String               @map("full_name")
  username        String               @unique @db.VarChar(100)
  passwordHash    String               @map("password_hash")
  phone           String?              @db.VarChar(32)
  roleId          String               @map("role_id") @db.Uuid
  role            Role                 @relation(fields: [roleId], references: [id], onDelete: Restrict)
  isActive        Boolean              @default(true) @map("is_active")
  clientProfile   ClientProfile?
  vendor          Vendor?
  orders          Order[]              @relation("ClientOrders")
  statusHistory   OrderStatusHistory[] @relation("HistoryActor")
  promotedClients ClientProfile[]      @relation("PromoterClients")
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")
  deletedAt       DateTime?            @map("deleted_at")
  createdById     String?              @map("created_by_id") @db.Uuid
  updatedById     String?              @map("updated_by_id") @db.Uuid

  @@index([roleId, isActive])
  @@index([deletedAt])
  @@map("users")
}

model ClientProfile {
  id                 String    @id @default(uuid()) @db.Uuid
  userId             String    @unique @map("user_id") @db.Uuid
  user               User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  organizationName   String    @map("organization_name")
  registrationNumber String?   @map("registration_number")
  contactName        String?   @map("contact_name")
  membershipNumber   String    @unique @map("membership_number")
  cardIssuedAt       DateTime? @map("card_issued_at")
  cardExpiresAt      DateTime? @map("card_expires_at")
  cardVersion        Int       @default(1) @map("card_version")
  promoterId         String?   @map("promoter_id") @db.Uuid
  promoter           User?     @relation("PromoterClients", fields: [promoterId], references: [id], onDelete: Restrict)
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  deletedAt          DateTime? @map("deleted_at")
  createdById        String?   @map("created_by_id") @db.Uuid
  updatedById        String?   @map("updated_by_id") @db.Uuid

  @@index([promoterId])
  @@index([registrationNumber])
  @@map("client_profiles")
}

model Region {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique @db.VarChar(32)
  name        String
  isActive    Boolean          @default(true) @map("is_active")
  vendors     Vendor[]
  rateCards   VendorRateCard[]
  orders      Order[]
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  deletedAt   DateTime?        @map("deleted_at")
  createdById String?          @map("created_by_id") @db.Uuid
  updatedById String?          @map("updated_by_id") @db.Uuid

  @@index([isActive, deletedAt])
  @@map("regions")
}

model ServiceCategory {
  id          String         @id @default(uuid()) @db.Uuid
  code        String         @unique @db.VarChar(32)
  name        String
  isActive    Boolean        @default(true) @map("is_active")
  services    Service[]
  vendors     Vendor[]
  workers     VendorWorker[]
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  deletedAt   DateTime?      @map("deleted_at")
  createdById String?        @map("created_by_id") @db.Uuid
  updatedById String?        @map("updated_by_id") @db.Uuid

  @@map("service_categories")
}

model Service {
  id                String           @id @default(uuid()) @db.Uuid
  code              String           @unique @db.VarChar(32)
  name              String
  categoryId        String           @map("category_id") @db.Uuid
  category          ServiceCategory  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  hideInitialPrice  Boolean          @default(true) @map("hide_initial_price")
  allowClientBudget Boolean          @default(false) @map("allow_client_budget")
  isActive          Boolean          @default(true) @map("is_active")
  rateCards         VendorRateCard[]
  orders            Order[]
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")
  deletedAt         DateTime?        @map("deleted_at")
  createdById       String?          @map("created_by_id") @db.Uuid
  updatedById       String?          @map("updated_by_id") @db.Uuid

  @@index([categoryId, isActive])
  @@map("services")
}

model Vendor {
  id                String                  @id @default(uuid()) @db.Uuid
  userId            String                  @unique @map("user_id") @db.Uuid
  user              User                    @relation(fields: [userId], references: [id], onDelete: Restrict)
  companyName       String                  @map("company_name")
  supervisorName    String                  @map("supervisor_name")
  regionId          String                  @map("region_id") @db.Uuid
  region            Region                  @relation(fields: [regionId], references: [id], onDelete: Restrict)
  categoryId        String                  @map("category_id") @db.Uuid
  category          ServiceCategory         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  contractType      ContractType            @map("contract_type")
  contractStartDate DateTime                @map("contract_start_date") @db.Date
  contractEndDate   DateTime                @map("contract_end_date") @db.Date
  status            VendorStatus            @default(ACTIVE)
  workers           VendorWorker[]
  ratings           VendorQuarterlyRating[]
  rateCards         VendorRateCard[]
  orders            Order[]
  custody           CustodyTransaction[]
  createdAt         DateTime                @default(now()) @map("created_at")
  updatedAt         DateTime                @updatedAt @map("updated_at")
  deletedAt         DateTime?               @map("deleted_at")
  createdById       String?                 @map("created_by_id") @db.Uuid
  updatedById       String?                 @map("updated_by_id") @db.Uuid

  @@index([regionId, categoryId, status])
  @@map("vendors")
}

model VendorQuarterlyRating {
  id                 String   @id @default(uuid()) @db.Uuid
  vendorId           String   @map("vendor_id") @db.Uuid
  vendor             Vendor   @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  year               Int
  quarter            Int
  rating             Decimal  @db.Decimal(3, 2)
  sampleCount        Int      @map("sample_count")
  avgResponseSeconds Int?     @map("avg_response_seconds")
  measuredAt         DateTime @map("measured_at")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")
  createdById        String?  @map("created_by_id") @db.Uuid
  updatedById        String?  @map("updated_by_id") @db.Uuid

  @@unique([vendorId, year, quarter])
  @@map("vendor_quarterly_ratings")
}

model VendorWorker {
  id               String          @id @default(uuid()) @db.Uuid
  vendorId         String          @map("vendor_id") @db.Uuid
  vendor           Vendor          @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  categoryId       String          @map("category_id") @db.Uuid
  category         ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  fullName         String          @map("full_name")
  employeeNumber   String          @map("employee_number")
  nationalIdNumber String          @map("national_id_number")
  identityImageKey String          @map("identity_image_key")
  isActive         Boolean         @default(true) @map("is_active")
  assignedOrders   Order[]         @relation("OrderWorker")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")
  deletedAt        DateTime?       @map("deleted_at")
  createdById      String?         @map("created_by_id") @db.Uuid
  updatedById      String?         @map("updated_by_id") @db.Uuid

  @@unique([vendorId, employeeNumber])
  @@unique([id, vendorId])
  @@index([vendorId, isActive])
  @@map("vendor_workers")
}

model VendorRateCard {
  id                  String    @id @default(uuid()) @db.Uuid
  vendorId            String    @map("vendor_id") @db.Uuid
  vendor              Vendor    @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  regionId            String    @map("region_id") @db.Uuid
  region              Region    @relation(fields: [regionId], references: [id], onDelete: Restrict)
  serviceId           String    @map("service_id") @db.Uuid
  service             Service   @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  agreedBaseCost      Decimal   @map("agreed_base_cost") @db.Decimal(18, 2)
  maxBaseCost         Decimal   @map("max_base_cost") @db.Decimal(18, 2)
  rawasiMarkupPercent Decimal   @map("rawasi_markup_percent") @db.Decimal(6, 4)
  currency            String    @db.Char(3)
  isActive            Boolean   @default(true) @map("is_active")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  deletedAt           DateTime? @map("deleted_at")
  createdById         String?   @map("created_by_id") @db.Uuid
  updatedById         String?   @map("updated_by_id") @db.Uuid

  @@unique([vendorId, regionId, serviceId, currency])
  @@index([regionId, serviceId, isActive])
  @@map("vendor_rate_cards")
}

model Order {
  id              String               @id @default(uuid()) @db.Uuid
  orderNumber     String               @unique @map("order_number")
  clientId        String               @map("client_id") @db.Uuid
  client          User                 @relation("ClientOrders", fields: [clientId], references: [id], onDelete: Restrict)
  regionId        String               @map("region_id") @db.Uuid
  region          Region               @relation(fields: [regionId], references: [id], onDelete: Restrict)
  serviceId       String               @map("service_id") @db.Uuid
  service         Service              @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  vendorId        String?              @map("vendor_id") @db.Uuid
  vendor          Vendor?              @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  workerId        String?              @map("worker_id") @db.Uuid
  worker          VendorWorker?        @relation("OrderWorker", fields: [workerId, vendorId], references: [id, vendorId], onDelete: Restrict)
  description     String
  clientNotes     String?              @map("client_notes")
  rejectionReason String?              @map("rejection_reason")
  status          OrderStatus          @default(SUBMITTED)
  version         Int                  @default(0)
  slaDeadlineAt   DateTime             @map("sla_deadline_at")
  firstResponseAt DateTime?            @map("first_response_at")
  costItems       OrderCostItem[]
  history         OrderStatusHistory[]
  custody         CustodyTransaction[]
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")
  deletedAt       DateTime?            @map("deleted_at")
  createdById     String?              @map("created_by_id") @db.Uuid
  updatedById     String?              @map("updated_by_id") @db.Uuid

  @@index([clientId, createdAt])
  @@index([vendorId, status])
  @@index([regionId, serviceId, status])
  @@index([status, slaDeadlineAt])
  @@map("orders")
}

model OrderCostItem {
  id            String       @id @default(uuid()) @db.Uuid
  orderId       String       @map("order_id") @db.Uuid
  order         Order        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  quoteVersion  Int          @map("quote_version")
  itemType      CostItemType @map("item_type")
  description   String
  vendorCost    Decimal      @map("vendor_cost") @db.Decimal(18, 2)
  clientPrice   Decimal      @map("client_price") @db.Decimal(18, 2)
  markupPercent Decimal      @map("markup_percent") @db.Decimal(6, 4)
  currency      String       @db.Char(3)
  approvedAt    DateTime?    @map("approved_at")
  approvedById  String?      @map("approved_by_id") @db.Uuid
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")
  deletedAt     DateTime?    @map("deleted_at")
  createdById   String?      @map("created_by_id") @db.Uuid
  updatedById   String?      @map("updated_by_id") @db.Uuid

  @@index([orderId, quoteVersion])
  @@map("order_cost_items")
}

model OrderStatusHistory {
  id           String       @id @default(uuid()) @db.Uuid
  orderId      String       @map("order_id") @db.Uuid
  order        Order        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  actorId      String       @map("actor_id") @db.Uuid
  actor        User         @relation("HistoryActor", fields: [actorId], references: [id], onDelete: Restrict)
  fromStatus   OrderStatus? @map("from_status")
  toStatus     OrderStatus  @map("to_status")
  internalNote String?      @map("internal_note")
  createdAt    DateTime     @default(now()) @map("created_at")

  @@index([orderId, createdAt])
  @@index([actorId])
  @@map("order_status_history")
}

model InventoryItem {
  id          String               @id @default(uuid()) @db.Uuid
  sku         String               @unique
  name        String
  unit        String
  availableQuantity Decimal @default(0) @map("available_quantity") @db.Decimal(18, 3)
  isActive    Boolean              @default(true) @map("is_active")
  custody     CustodyTransaction[]
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")
  deletedAt   DateTime?            @map("deleted_at")
  createdById String?              @map("created_by_id") @db.Uuid
  updatedById String?              @map("updated_by_id") @db.Uuid

  @@map("inventory_items")
}

model CustodyTransaction {
  id          String        @id @default(uuid()) @db.Uuid
  vendorId    String        @map("vendor_id") @db.Uuid
  vendor      Vendor        @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  orderId     String        @map("order_id") @db.Uuid
  order       Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  itemId      String        @map("item_id") @db.Uuid
  item        InventoryItem @relation(fields: [itemId], references: [id], onDelete: Restrict)
  type        CustodyType
  quantity    Decimal       @db.Decimal(18, 3)
  referenceNo String        @unique @map("reference_no")
  notes       String?
  createdAt   DateTime      @default(now()) @map("created_at")
  createdById String        @map("created_by_id") @db.Uuid

  @@index([vendorId, itemId, createdAt])
  @@index([orderId])
  @@map("custody_transactions")
}
